# =============================================================================
# Career Ladder Chatbot — Backend Environment Configuration Example
# Copy this file to '.env' and fill in your Gemini API key.
# DO NOT commit '.env' to version control.
# =============================================================================

# Google Gemini API Key (Get yours at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Gemini Model (e.g. gemini-2.0-flash, gemini-1.5-flash, gemini-1.5-pro)
GEMINI_MODEL=gemini-2.0-flash

# Backend Server Configuration
PORT=5000
HOST=0.0.0.0

# Allowed Frontend Origins for Local CORS (comma-separated if multiple)
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# =============================================================================
# Supabase Database Configuration
# Obtain these from your Supabase Dashboard: Project Settings -> API
# =============================================================================
# Project URL (e.g. https://your-project-ref.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon / Public API Key
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Service Role Secret Key (recommended for backend server; bypasses RLS for administrative access)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
